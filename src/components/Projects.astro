        class: "text-jota-yellow border-jota-yellow/50",
        dot: "bg-jota-yellow",
        live: true
    },
    FINISHED: {
        label: "Finalizado",
        class: "text-gray-300 border-gray-400/40",
        dot: "bg-gray-400",
        live: false
    },
