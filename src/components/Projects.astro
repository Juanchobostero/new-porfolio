        link: 'https://www.ohmingelectromecanica.com.ar/',
        image: '/projects/ohm.webp',
        tags: [TAGS.ASTRO, TAGS.NODE],
        status: STATUS.PRODUCTION,
        statusNote: 'Dominio propio del cliente'
    },
