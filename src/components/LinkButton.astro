---
export interface Props {
  href: string
  variant?: 'primary' | 'secondary'
}

const { href, variant = 'secondary' } = Astro.props as Props

const variants: Record<'primary' | 'secondary', string> = {
  primary: `bg-sky-500 border border-sky-400
    text-white font-medium
    hover:bg-sky-400 hover:shadow-lg hover:shadow-sky-500/40
    active:bg-sky-600`,
  secondary: `bg-white/5
    border dark:border-white/10 border-gray-300
    hover:bg-white/15 hover:border-sky-400/60 hover:shadow-lg hover:shadow-sky-500/30
    active:bg-white/10`,
}
---

<a
  href={href}
  class={`${variants[variant]}
    rounded-lg
    inline-flex justify-center items-center gap-x-2
    py-2 px-4 md:py-2.5 md:px-5
    text-xs md:text-base
    transition-all duration-300 ease-out
    hover:scale-105 hover:-translate-y-0.5
    active:scale-95`}
    rel="noopener noreferrer"
    target="_blank"
>
  <slot />
</a>
