---
interface Props {
    label: string;
}
const { label } = Astro.props;
---

<span class="inline-flex items-center gap-x-2 py-1 px-3 rounded-full text-xs font-medium bg-green-500/10 border border-green-500/40 text-green-300 whitespace-nowrap">
    <span class="relative flex size-2">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
        <span class="relative inline-flex rounded-full size-2 bg-green-400"></span>
    </span>
    {label}
</span>
