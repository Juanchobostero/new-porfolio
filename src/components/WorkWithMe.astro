---
import SocialPill from "./SocialPill.astro";
import Mail from "./icons/Mail.astro";
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url));
---

<section id="contacto" class="flex flex-row gap-8 justify-start m-1">
    <div class="p-1 flex flex-col sm:flex-row sm:items-center gap-4">
        <h2 class="text-2xl"><span class="text-jota-steel font-bold">{t('work.question')} </span><span class="text-gray-100">{t('work.together')}</span></h2>
        <SocialPill href="mailto:juancruzmart93@gmail.com" aria-label={t('hero.email')}>
            <Mail class="size-4 md:size-6" aria-hidden="true"/>
            	{t('work.cta')}
        </SocialPill>
    </div>
</section>

<style>
    @keyframes reveal {
		from {
			opacity: 0;
			transform: 0 100px;
		}
		to {
			opacity: 1;
			transform: 0 0;
		}
	}

	section {
		animation: reveal both;
		animation-timeline: view();
		animation-range: entry 20% cover 30%;
	}
</style>