---
import ASPNET from './icons/ASPNET.astro';
import JavaScript from './icons/JavaScript.astro';
import Postgre from './icons/Postgre.astro';
import Node from './icons/Node.astro';
import NestJS from './icons/NestJS.astro';
import Vue from './icons/Vue.astro';
import HTML from './icons/HTML.astro';
import CSS from './icons/CSS.astro';
import PHP from './icons/PHP.astro';
import Python from './icons/Python.astro';
import MySQL from './icons/MySQL.astro';
import Git from './icons/Git.astro';
import Mongo from './icons/Mongo.astro';
import ReactJS from './icons/ReactJS.astro';
import Express from './icons/Express.astro';
import GCP from './icons/GCP.astro';
import Angular from './icons/Angular.astro';
import Code from './icons/Code.astro';
import { getLangFromUrl, useTranslations } from '../i18n/ui';

const t = useTranslations(getLangFromUrl(Astro.url));

export interface Props {
    title: string,
    description: string,
    link?: string,
    date: string,
    current: boolean,
    role: string,
    summary: string,
    open?: boolean,
    technologies?: string[]
}
const { title, description, link, date, current, role, summary, open = false, technologies = [] } = Astro.props

// Mapeo de tecnologías a componentes de iconos y URLs
const techData: Record<string, { icon: any, name: string, url: string }> = {
    '.net': { icon: ASPNET, name: 'ASP.NET Core', url: 'https://dotnet.microsoft.com/' },
    'angular': { icon: Angular, name: 'Angular', url: 'https://angular.dev/' },
    'solr': { icon: Code, name: 'Apache Solr', url: 'https://solr.apache.org/' },
    'postman': { icon: Code, name: 'Postman', url: 'https://www.postman.com/' },
    'ionic': { icon: Code, name: 'Ionic', url: 'https://ionicframework.com/' },
    'js': { icon: JavaScript, name: 'JavaScript', url: 'https://developer.mozilla.org/es/docs/Web/JavaScript' },
    'javascript': { icon: JavaScript, name: 'JavaScript', url: 'https://developer.mozilla.org/es/docs/Web/JavaScript' },
    'postgresql': { icon: Postgre, name: 'PostgreSQL', url: 'https://www.postgresql.org/' },
    'node': { icon: Node, name: 'Node.js', url: 'https://nodejs.org/' },
    'nestjs': { icon: NestJS, name: 'NestJS', url: 'https://nestjs.com/' },
    'vue': { icon: Vue, name: 'Vue.js', url: 'https://vuejs.org/' },
    'html': { icon: HTML, name: 'HTML5', url: 'https://developer.mozilla.org/es/docs/Web/HTML' },
    'css': { icon: CSS, name: 'CSS3', url: 'https://developer.mozilla.org/es/docs/Web/CSS' },
    'php': { icon: PHP, name: 'PHP', url: 'https://www.php.net/' },
    'python': { icon: Python, name: 'Python', url: 'https://www.python.org/' },
    'mysql': { icon: MySQL, name: 'MySQL', url: 'https://www.mysql.com/' },
    'git': { icon: Git, name: 'Git', url: 'https://git-scm.com/' },
    'mongodb': { icon: Mongo, name: 'MongoDB', url: 'https://www.mongodb.com/' },
    'react': { icon: ReactJS, name: 'React', url: 'https://react.dev/' },
    'express': { icon: Express, name: 'Express', url: 'https://expressjs.com/' },
    'gcp': { icon: GCP, name: 'Google Cloud', url: 'https://cloud.google.com/' },
}
---

    <div class:list={[
        "absolute size-3 rounded-full mt-1.5 -start-1.5 border",
        current ? "bg-jota-yellow border-jota-yellow/40 shadow-[0_0_10px_rgba(250,204,21,0.6)]" : "bg-jota-circuit border-jota-steel/40"
    ]}></div>
        <details class="exp-item group/exp" open={open}>
            <summary class="cursor-pointer list-none rounded-lg -mx-2 px-2 py-1 hover:bg-white/5 transition-colors">
                <div class="flex items-center gap-x-2">
                    <time class="text-sm font-normal leading-none text-jota-cyan">{date}</time>
                    {current && <span class="text-[10px] font-semibold uppercase tracking-wider text-jota-yellow border border-jota-yellow/40 rounded-full px-2 py-0.5">{t('experience.current')}</span>}
                </div>
                <div class="flex items-start justify-between gap-x-3 mt-1">
                    <div>
                        <h3 class="text-lg font-semibold text-jota-ice">{role}</h3>
                        <p class="text-base font-medium text-jota-yellow" set:html={title}></p>
                    </div>
                    <svg class="size-5 shrink-0 mt-1 text-gray-400 transition-transform duration-300 group-open/exp:rotate-180" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" /></svg>
                </div>
                <p class="text-base text-gray-300 mt-1">{summary}</p>
            </summary>
            <p class="mt-3 text-base font-normal text-gray-400 border-l-2 border-jota-teal/40 pl-3" set:html={description}></p>
        </details>

        {technologies.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-3">
                {technologies.map(tech => {
                    const techInfo = techData[tech.toLowerCase()];
                    if (techInfo) {
                        const IconComponent = techInfo.icon;
                        return (
                            <a 
                                href={techInfo.url} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="group inline-flex items-center gap-1.5 px-2 py-1 text-xs font-medium text-gray-300 bg-white/5 border border-white/10 rounded-md hover:border-jota-teal/60 hover:bg-white/10 hover:text-white transition-all"
                                aria-label={`${t('experience.docs')} ${techInfo.name}`}
                            >
                                <IconComponent class="size-4 group-hover:scale-110 transition-transform" />
                                {techInfo.name}
                            </a>
                        );
                    }
                    return (
                        <span class="inline-flex items-center px-2 py-1 text-xs font-medium bg-white/5 border border-white/10 rounded-md text-gray-400">
                            {tech}
                        </span>
                    );
                })}
            </div>
        )}
        <!-- <a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700">Learn more <svg class="w-3 h-3 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
  </svg></a> -->
        <!-- <a href="#" class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-100 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700">Learn more <svg class="w-3 h-3 ms-2 rtl:rotate-180" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10">
    <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M1 5h12m0 0L9 1m4 4L9 9"/>
  </svg></a> -->

{
    link && (
    <a 
        href={link}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`Visitar sitio web de ${title.split(' - ')[0]}`}
        class="inline-flex items-center px-4 py-2 text-sm font-medium text-gray-900 bg-white border border-gray-200 rounded-lg hover:bg-gray-100 hover:text-blue-700 focus:z-10 focus:ring-4 focus:outline-none focus:ring-gray-200 focus:text-blue-700 dark:bg-gray-800 dark:text-gray-400 dark:border-gray-600 dark:hover:text-white dark:hover:bg-gray-700 dark:focus:ring-gray-700"
>
    <svg class="w-3.5 h-3.5 me-2.5" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="currentColor" viewBox="0 0 20 20">
    <path d="M14.707 7.793a1 1 0 0 0-1.414 0L11 10.086V1.5a1 1 0 0 0-2 0v8.586L6.707 7.793a1 1 0 1 0-1.414 1.414l4 4a1 1 0 0 0 1.416 0l4-4a1 1 0 0 0-.002-1.414Z"/>
    <path d="M18 12h-2.55l-2.975 2.975a3.5 3.5 0 0 1-4.95 0L4.55 12H2a2 2 0 0 0-2 2v4a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-4a2 2 0 0 0-2-2Zm-3 5a1 1 0 1 1 0-2 1 1 0 0 1 0 2Z"/>
    </svg> 
        Visitar sitio web
</a>
    )
}

<style>
    .pill {
        color: white !important;
        transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
    }
    .pill:hover {
        opacity: 0.8;
        transform: translateY(-2px);
    }

    .exp-item summary::-webkit-details-marker {
        display: none;
    }

</style>


